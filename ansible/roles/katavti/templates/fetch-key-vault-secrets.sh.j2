#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

metadata_url='http://169.254.169.254/metadata/identity/oauth2/token'
vault_url='https://{{ katavti_key_vault_name }}.vault.azure.net'

curl --fail --silent --show-error --get \
  --header Metadata:true \
  --data-urlencode api-version=2018-02-01 \
  --data-urlencode resource=https://vault.azure.net \
  --data-urlencode client_id={{ katavti_key_vault_managed_identity_client_id | quote }} \
  "$metadata_url" \
  >"$tmp_dir/token.json"

python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])' \
  <"$tmp_dir/token.json" \
  >"$tmp_dir/token"

curl --fail --silent --show-error \
  --header "Authorization: Bearer $(<"$tmp_dir/token")" \
  "$vault_url/secrets/{{ katavti_key_vault_google_client_id_secret }}/?api-version=7.4" \
  >"$tmp_dir/google-client-id.json"
{% if katavti_smtp_enabled | bool %}
curl --fail --silent --show-error \
  --header "Authorization: Bearer $(<"$tmp_dir/token")" \
  "$vault_url/secrets/{{ katavti_key_vault_smtp_url_secret }}/?api-version=7.4" \
  >"$tmp_dir/smtp-url.json"

python3 -c 'import json,sys; print(json.dumps({"auth": {"googleClientId": json.load(open(sys.argv[1]))["value"], "smtpUrl": json.load(open(sys.argv[2]))["value"]}}))' \
  "$tmp_dir/google-client-id.json" \
  "$tmp_dir/smtp-url.json" \
  >{{ (katavti_config_dir + '/secrets.yaml') | quote }}
{% else %}
python3 -c 'import json,sys; print(json.dumps({"auth": {"googleClientId": json.load(sys.stdin)["value"]}}))' \
  <"$tmp_dir/google-client-id.json" \
  >{{ (katavti_config_dir + '/secrets.yaml') | quote }}
{% endif %}

chown root:{{ katavti_system_user | quote }} {{ (katavti_config_dir + '/secrets.yaml') | quote }}
chmod 0640 {{ (katavti_config_dir + '/secrets.yaml') | quote }}
