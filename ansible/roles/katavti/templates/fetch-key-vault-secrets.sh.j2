#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

metadata_url='http://169.254.169.254/metadata/identity/oauth2/token'
vault_url='https://{{ katavti_key_vault_name }}.vault.azure.net'

curl --fail --silent --show-error --get \
  --header Metadata:true \
  --data-urlencode api-version=2018-02-01 \
  --data-urlencode resource=https://vault.azure.net \
  --data-urlencode client_id={{ katavti_key_vault_managed_identity_client_id | quote }} \
  "$metadata_url" \
  >"$tmp_dir/token.json"

python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])' \
  <"$tmp_dir/token.json" \
  >"$tmp_dir/token"

fetch_secret() {
  curl --fail --silent --show-error \
    --header "Authorization: Bearer $(<"$tmp_dir/token")" \
    "$vault_url/secrets/$1/?api-version=7.4"
}

fetch_secret {{ katavti_key_vault_google_client_id_secret | quote }} \
  >"$tmp_dir/google-client-id.json"
{% if katavti_smtp_mode == 'url' %}
fetch_secret {{ katavti_key_vault_smtp_url_secret | quote }} \
  >"$tmp_dir/smtp-url.json"

python3 -c 'import json,sys; print(json.dumps({"auth": {"googleClientId": json.load(open(sys.argv[1]))["value"], "smtpUrl": json.load(open(sys.argv[2]))["value"]}}))' \
  "$tmp_dir/google-client-id.json" \
  "$tmp_dir/smtp-url.json" \
  >{{ (katavti_config_dir + '/secrets.yaml') | quote }}
{% elif katavti_smtp_mode == 'gmail_oauth2' %}
fetch_secret {{ katavti_key_vault_smtp_oauth_user_secret | quote }} \
  >"$tmp_dir/smtp-oauth-user.json"
fetch_secret {{ katavti_key_vault_smtp_oauth_client_id_secret | quote }} \
  >"$tmp_dir/smtp-oauth-client-id.json"
fetch_secret {{ katavti_key_vault_smtp_oauth_client_secret_secret | quote }} \
  >"$tmp_dir/smtp-oauth-client-secret.json"
fetch_secret {{ katavti_key_vault_smtp_oauth_refresh_token_secret | quote }} \
  >"$tmp_dir/smtp-oauth-refresh-token.json"

python3 -c 'import json,sys; value=lambda p: json.load(open(p))["value"]; print(json.dumps({"auth": {"googleClientId": value(sys.argv[1]), "smtpOAuth": {"user": value(sys.argv[2]), "clientId": value(sys.argv[3]), "clientSecret": value(sys.argv[4]), "refreshToken": value(sys.argv[5])}}}))' \
  "$tmp_dir/google-client-id.json" \
  "$tmp_dir/smtp-oauth-user.json" \
  "$tmp_dir/smtp-oauth-client-id.json" \
  "$tmp_dir/smtp-oauth-client-secret.json" \
  "$tmp_dir/smtp-oauth-refresh-token.json" \
  >{{ (katavti_config_dir + '/secrets.yaml') | quote }}
{% else %}
python3 -c 'import json,sys; print(json.dumps({"auth": {"googleClientId": json.load(sys.stdin)["value"]}}))' \
  <"$tmp_dir/google-client-id.json" \
  >{{ (katavti_config_dir + '/secrets.yaml') | quote }}
{% endif %}

chown root:{{ katavti_system_user | quote }} {{ (katavti_config_dir + '/secrets.yaml') | quote }}
chmod 0640 {{ (katavti_config_dir + '/secrets.yaml') | quote }}
